<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка персонажа в стиле BlueOS: персонаж, затемнение снизу,
     имя лавандовым и статус белым. Кадры переключаются с плавным кроссфейдом. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg">

    <!-- «Дыхание»: три кадра, ViewFlipper переключает их с кроссфейдом -->
    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="1500"
        android:inAnimation="@anim/fade_in"
        android:outAnimation="@anim/fade_out">

        <ImageView
            android:id="@+id/character"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/character_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/character_c"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:scaleType="fitCenter" />

    </ViewFlipper>

    <!-- Затемнение к низу поверх персонажа -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_scrim" />

    <!-- Подпись внизу слева: имя и статус -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B9B3D6"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

    </LinearLayout>

    <!-- Подсказка, если картинки нет -->
    <TextView
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FF8899AA"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
